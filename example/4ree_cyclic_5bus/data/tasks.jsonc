{
  "tasks": [
    {
      "kind": "Echo",
      "params": {
        "results": {
          "path": "out/echo",
          "save": false,
          "format": {
            "kind": "AnyFormat",
            "params": {}
          }
        }
      }
    },
    {
      "kind": "Policy",
      "params": {
        "convergence": {
          // Min/Max number of iterations
          "min_iterations": 2,
          "max_iterations": 1024,
          // Early stopping criteria and params
          "stopping_criteria": {
            // IterationLimit | TimeLimit | LowerBoundStability | Statistical | ...
            // The frozen SDDP-IH CSV was trained with time_limit=120s
            // (julia_compare.jl). 500 iterations is a committed-example default;
            // bump for a production policy. See MIGRATION.md.
            "kind": "IterationLimit",
            "params": {
              "num_iterations": 500
            }
          }
        },
        // Risk-neutral: the SDDP-IH analog. For the CVaR-SDDP-IH analog swap this
        // to {"kind": "CVaR", "params": {"alpha": 0.15, "lambda": 0.5}} — the old
        // path (julia_cvar.jl) used SDDP.EAVaR(lambda=0.5, beta=0.15). VERIFY the
        // lab's alpha/lambda convention against EAVaR before trusting CVaR numbers
        // (see MIGRATION.md step 4).
        "risk_measure": {
          // Expectation | WorstCase | AVaR | CVaR | ...
          "kind": "Expectation",
          "params": {}
        },
        "parallel_scheme": {
          "kind": "Serial",
          "params": {}
        },
        "results": {
          "path": "out/policy",
          "save": true,
          "format": {
            "kind": "ParquetFormat",
            "params": {}
          }
        }
      }
    },
    {
      "kind": "Simulation",
      "params": {
        "num_simulated_series": 2000,
        "policy": {
          "load": false,
          "path": "out/policy",
          "format": {
            "kind": "ParquetFormat",
            "params": {}
          }
        },
        "parallel_scheme": {
          "kind": "Serial",
          "params": {}
        },
        "results": {
          "path": "out/simulation",
          "save": true,
          "format": {
            "kind": "ParquetFormat",
            "params": {}
          }
        }
      }
    }
  ]
}